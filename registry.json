{
  "$schema": "https://github.com/with-fh/.forkhub/blob/main/registry.schema.json",
  "packages": {
    "t3": {
      "target": "github.com/pingdotgg/t3code",
      "description": "T3 Code x ForkHub headless CLI",
      "bin": "t3",
      "binPath": "package/t3",
      "defaultChannel": "nightly",
      "asset": "{owner}-fh-t3-{version}.tgz",
      "platforms": [
        "linux-x64"
      ],
      "channels": {
        "nightly": {
          "tagMatch": "-nightly\\.[0-9]{8}\\."
        },
        "stable": {
          "tagMatch": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "natively": {
      "target": "github.com/Natively-AI-assistant/natively-cluely-ai-assistant",
      "description": "Natively x ForkHub update channel for Windows (Linux served by the ImBIOS catalog; macOS via the in-app updater for now)",
      "bin": "Natively",
      "defaultChannel": "stable",
      "asset": "Natively.{version}.exe",
      "assets": {
        "win32-x64": "Natively.{version}.exe"
      },
      "binPaths": {
        "win32-x64": "{asset}"
      },
      "extract": "none",
      "platforms": [
        "win32-x64"
      ],
      "channels": {
        "stable": {
          "tagMatch": "^v[0-9]+\\.[0-9]+\\.[0-9]+-fh\\."
        }
      }
    },
    "dsh": {
      "target": "github.com/deepseek-ai/deepseek-harness",
      "description": "DeepSeek Harness Desktop x ForkHub update channel for Windows + macOS (Linux served by the ImBIOS catalog; needs 277k★ upstream, channel patch draft until fh draft realization)",
      "bin": "dsh",
      "defaultChannel": "stable",
      "asset": "dsh-{version}.exe",
      "assets": {
        "win32-x64": "dsh-{version}.exe",
        "darwin-arm64": "dsh-{version}-arm64.dmg",
        "darwin-x64": "dsh-{version}-x64.dmg"
      },
      "binPaths": {
        "win32-x64": "{asset}",
        "darwin-arm64": "{asset}",
        "darwin-x64": "{asset}"
      },
      "extract": "none",
      "platforms": [
        "win32-x64",
        "darwin-arm64",
        "darwin-x64"
      ],
      "channels": {
        "stable": {
          "tagMatch": "^v[0-9]+\\.[0-9]+\\.[0-9]+-fh\\."
        }
      }
    },
    "opendia": {
      "target": "github.com/aeonfun/opendia",
      "description": "OpenDia x ForkHub channel: Mozilla-signed Firefox XPI (re-ID + unlisted sign, until upstream ships one)",
      "bin": "opendia",
      "asset": "opendia-firefox.{version}.xpi",
      "platforms": [
        "linux-x64"
      ],
      "defaultChannel": "stable",
      "channels": {
        "stable": {
          "tagMatch": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
