diff --git a/apps/desktop/tests/forkhub-usage.spec.ts b/apps/desktop/tests/forkhub-usage.spec.ts
new file mode 100644
index 0000000000..2ffdc4b72d
--- /dev/null
+++ b/apps/desktop/tests/forkhub-usage.spec.ts
@@ -0,0 +1,45 @@
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, expect, test, vi } from 'vitest'
+import { createForkHubUsageReporter, forkHubUsageEnabled } from '../src/forkhubUsage.ts'
+
+let userData: string
+const version = '0.2.2-rc.5.with-fh.20261126.1'
+
+beforeEach(async () => { userData = await mkdtemp(join(tmpdir(), 'forkhub-usage-')) })
+afterEach(async () => { await rm(userData, { recursive: true, force: true }) })
+
+test('honors T3-style opt-out and CI precedence', () => {
+  expect(forkHubUsageEnabled({})).toBe(true)
+  expect(forkHubUsageEnabled({ FORKHUB_TELEMETRY_ENABLED: 'false' })).toBe(false)
+  expect(forkHubUsageEnabled({ DO_NOT_TRACK: '1', FORKHUB_TELEMETRY_ENABLED: 'true' })).toBe(false)
+  expect(forkHubUsageEnabled({ DO_NOT_TRACK: ' yes ' })).toBe(false)
+  expect(forkHubUsageEnabled({ TF_BUILD: 'True' })).toBe(false)
+  expect(forkHubUsageEnabled({ GITHUB_ACTIONS: 'true' })).toBe(false)
+  expect(forkHubUsageEnabled({ CI: 'true', FORKHUB_TELEMETRY_ENABLED: 'true' })).toBe(true)
+})
+
+test('sends only a hashed installation ID and version once per UTC day', async () => {
+  let now = Date.parse('2026-11-26T23:59:00Z')
+  const send = vi.fn<typeof fetch>().mockResolvedValue(new Response(null, { status: 204 }))
+  const report = createForkHubUsageReporter({ version, userData, environment: Promise.resolve({}), send, now: () => now })
+  await Promise.all([report(), report()])
+  await report()
+  expect(send).toHaveBeenCalledTimes(1)
+  const payload = JSON.parse(String(send.mock.calls[0]?.[1]?.body))
+  expect(payload).toEqual({ installationId: expect.stringMatching(/^[0-9a-f]{64}$/), version })
+  expect(payload.installationId).not.toBe(await readFile(join(userData, 'forkhub-usage-id'), 'utf8'))
+  now += 60_000
+  await report()
+  expect(send).toHaveBeenCalledTimes(2)
+  expect(JSON.parse(String(send.mock.calls[1]?.[1]?.body))).toEqual(payload)
+})
+
+test('creates no installation ID and sends no request when opted out', async () => {
+  const send = vi.fn<typeof fetch>()
+  const report = createForkHubUsageReporter({ version, userData, environment: Promise.resolve({ DO_NOT_TRACK: '1' }), send })
+  await report()
+  expect(send).not.toHaveBeenCalled()
+  await expect(readFile(join(userData, 'forkhub-usage-id'))).rejects.toMatchObject({ code: 'ENOENT' })
+})
