+/** Report daily foreground use of the ForkHub Linux release. */
+import { createHash, randomUUID } from 'node:crypto'
+import { mkdir, readFile, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+
+const endpoint = 'https://forkhub.imbios.dev/api/usage/deepseek-harness'
+const trueValues = ['true', 'yes', 'on', '1', 'y']
+const ciVariables = [
+  'CI', 'GITHUB_ACTIONS', 'GITLAB_CI', 'CIRCLECI', 'TRAVIS', 'BUILDKITE',
+  'JENKINS_URL', 'TEAMCITY_VERSION', 'TF_BUILD', 'BITBUCKET_BUILD_NUMBER',
+  'CODEBUILD_BUILD_ID', 'DRONE', 'APPVEYOR',
+]
+const forkHubVersion = /^\d+\.\d+\.\d+(?:-[\da-z.-]+)?\.with-fh\.\d{8}\.\d+$/iu
+
+export function forkHubUsageOptedOut(environment: NodeJS.ProcessEnv): boolean {
+  const preference = environment.FORKHUB_TELEMETRY_ENABLED
+  return trueValues.includes(environment.DO_NOT_TRACK?.trim().toLowerCase() ?? '')
+    || (preference !== undefined && !trueValues.includes(preference.trim().toLowerCase()))
+}
+
+export function forkHubUsageEnabled(environment: NodeJS.ProcessEnv): boolean {
+  if (forkHubUsageOptedOut(environment)) return false
+  if (environment.FORKHUB_TELEMETRY_ENABLED !== undefined) return true
+  return ciVariables.every(name => {
+    const value = environment[name]?.trim().toLowerCase()
+    return value === undefined || value === '' || value === '0' || value === 'false'
+  })
+}
+
+async function installationId(userData: string): Promise<string> {
+  const file = join(userData, 'forkhub-usage-id')
+  await mkdir(userData, { recursive: true })
+  const candidate = randomUUID()
+  await writeFile(file, candidate, { flag: 'wx', mode: 0o600 }).catch((error: unknown) => {
+    if (!(error instanceof Error && 'code' in error && error.code === 'EEXIST')) throw error
+  })
+  const seed = await readFile(file, 'utf8')
+  if (!/^[a-f\d]{8}(?:-[a-f\d]{4}){3}-[a-f\d]{12}$/u.test(seed)) throw new Error('Invalid ForkHub usage ID')
+  return createHash('sha256').update('forkhub:dsh-linux:').update(seed).digest('hex')
+}
+
+export function createForkHubUsageReporter({
+  version,
+  userData,
+  environment,
+  send = fetch,
+  now = Date.now,
+}: {
+  version: string
+  userData: string
+  environment: Promise<NodeJS.ProcessEnv>
+  send?: typeof fetch
+  now?: () => number
+}): () => Promise<void> {
+  let lastReportedDay = ''
+  let retryAfter = 0
+  let pending = false
+
+  return async () => {
+    const timestamp = now()
+    const day = new Date(timestamp).toISOString().slice(0, 10)
+    if (!forkHubVersion.test(version) || day === lastReportedDay || pending || timestamp < retryAfter) return
+    pending = true
+    try {
+      if (!forkHubUsageEnabled(await environment)) return
+      const response = await send(endpoint, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ installationId: await installationId(userData), version }),
+        redirect: 'error',
+        signal: AbortSignal.timeout(5000),
+      })
+      if (response.status === 204) lastReportedDay = day
+      else retryAfter = timestamp + 60_000
+    } catch {
+      retryAfter = timestamp + 60_000
+    } finally {
+      pending = false
+    }
+  }
+}
