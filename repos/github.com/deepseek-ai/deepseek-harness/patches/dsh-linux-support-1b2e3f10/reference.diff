diff --git a/apps/desktop/tests/linux-autostart.spec.ts b/apps/desktop/tests/linux-autostart.spec.ts
new file mode 100644
index 00000000..e316f382
--- /dev/null
+++ b/apps/desktop/tests/linux-autostart.spec.ts
@@ -0,0 +1,72 @@
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+  buildLinuxAutostartEntry,
+  getLinuxOpenAtLogin,
+  linuxAutostartFilePath,
+  LINUX_AUTOSTART_FILENAME,
+  resolveLaunchPath,
+  setLinuxOpenAtLogin,
+} from '../src/linuxAutostart.ts'
+
+const LINUX = { platform: 'linux' } as const
+let directories: string[] = []
+
+async function configHome(): Promise<string> {
+  const directory = await mkdtemp(join(tmpdir(), 'dsh-autostart-'))
+  directories.push(directory)
+  return directory
+}
+
+afterEach(async () => {
+  for (const directory of directories.splice(0)) await rm(directory, { recursive: true, force: true })
+})
+
+describe('linux autostart', () => {
+  it('writes, reads, and disables a round-trip entry', async () => {
+    const XDG_CONFIG_HOME = await configHome()
+    const env = { ...LINUX, XDG_CONFIG_HOME, argv0: '/opt/dsh/dsh' }
+    expect(getLinuxOpenAtLogin(env)).toBe(false)
+    expect(setLinuxOpenAtLogin(true, env)).toBe(true)
+    expect(getLinuxOpenAtLogin(env)).toBe(true)
+    expect(setLinuxOpenAtLogin(false, env)).toBe(true)
+    expect(getLinuxOpenAtLogin(env)).toBe(false)
+    const path = linuxAutostartFilePath(env)
+    expect(path).toBe(join(XDG_CONFIG_HOME, 'autostart', LINUX_AUTOSTART_FILENAME))
+    expect(await readFile(path, 'utf8')).toContain('Hidden=true')
+  })
+
+  it('quotes paths with spaces and never emits field codes', async () => {
+    const XDG_CONFIG_HOME = await configHome()
+    const env = { ...LINUX, XDG_CONFIG_HOME, argv0: '/opt/my apps/dsh "special"' }
+    expect(setLinuxOpenAtLogin(true, env)).toBe(true)
+    const contents = await readFile(linuxAutostartFilePath(env), 'utf8')
+    expect(contents).toMatch(/^Exec="/gmu)
+    expect(contents).not.toMatch(/ %[a-z]/gimu)
+    expect(contents).toContain('StartupWMClass=DeepSeek Harness')
+  })
+
+  it('prefers the FUSE AppImage path', () => {
+    expect(resolveLaunchPath({ ...LINUX, APPIMAGE: '/tmp/.mount_dshXYZ/AppRun', argv0: '/other' }))
+      .toBe('/tmp/.mount_dshXYZ/AppRun')
+    expect(resolveLaunchPath({ ...LINUX, argv0: '/opt/dsh' })).toBe('/opt/dsh')
+  })
+
+  it('reads missing files as disabled', async () => {
+    const XDG_CONFIG_HOME = await configHome()
+    expect(getLinuxOpenAtLogin({ ...LINUX, XDG_CONFIG_HOME })).toBe(false)
+  })
+
+  it('treats Hidden=true as off', () => {
+    expect(buildLinuxAutostartEntry('/opt/dsh', false)).toContain('Hidden=true')
+    expect(buildLinuxAutostartEntry('/opt/dsh', true)).toContain('Hidden=false')
+  })
+
+  it('fails closed on other platforms without throwing', async () => {
+    const XDG_CONFIG_HOME = await configHome()
+    expect(setLinuxOpenAtLogin(true, { platform: 'darwin', XDG_CONFIG_HOME })).toBe(false)
+    expect(getLinuxOpenAtLogin({ platform: 'darwin', XDG_CONFIG_HOME })).toBe(false)
+  })
+})
