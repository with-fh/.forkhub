diff --git a/apps/desktop/src/linuxAutostart.ts b/apps/desktop/src/linuxAutostart.ts
new file mode 100644
index 00000000..76d6298a
--- /dev/null
+++ b/apps/desktop/src/linuxAutostart.ts
@@ -0,0 +1,108 @@
+/** XDG autostart entry manager for Linux open-at-login. */
+
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+import { join } from 'node:path'
+
+/** Desktop entry filename registered under ~/.config/autostart. */
+export const LINUX_AUTOSTART_FILENAME = 'deepseek-harness.desktop'
+
+/** Injectable environment and platform for tests. */
+export interface LinuxAutostartEnv {
+  readonly XDG_CONFIG_HOME?: string
+  readonly HOME?: string
+  readonly APPIMAGE?: string
+  readonly platform?: NodeJS.Platform
+  readonly argv0?: string
+}
+
+function configHome(env: LinuxAutostartEnv): string {
+  if (env.XDG_CONFIG_HOME !== undefined && env.XDG_CONFIG_HOME !== '') return env.XDG_CONFIG_HOME
+  const home = env.HOME ?? homedir()
+  return join(home, '.config')
+}
+
+/**
+ * Resolve the autostart entry path.
+ * @param env - Injectable environment for tests.
+ * @returns Autostart desktop-entry path.
+ */
+export function linuxAutostartFilePath(env: LinuxAutostartEnv = {}): string {
+  return join(configHome(env), 'autostart', LINUX_AUTOSTART_FILENAME)
+}
+
+function quotedExec(command: string): string {
+  return /[\s"\\]/u.test(command) ? `"${command.replaceAll('\\', '\\\\').replaceAll('"', '\\"')}"` : command
+}
+
+/**
+ * Prefer the FUSE-mounted AppImage path so the entry survives extraction moves.
+ * @param env - Injectable environment for tests.
+ * @returns Launch path for the Exec line.
+ */
+export function resolveLaunchPath(env: LinuxAutostartEnv = {}): string {
+  const appImage = env.APPIMAGE ?? process.env.APPIMAGE
+  if (appImage !== undefined && appImage !== '') return appImage
+  return env.argv0 ?? process.argv[0] ?? process.execPath
+}
+
+/**
+ * Build the XDG desktop entry; no % field codes so the shell never interprets them.
+ * @param execPath - Launch path.
+ * @param enabled - Whether autostart is enabled.
+ * @returns Desktop-entry contents.
+ */
+export function buildLinuxAutostartEntry(execPath: string, enabled: boolean): string {
+  return [
+    '[Desktop Entry]',
+    'Type=Application',
+    'Name=DeepSeek Harness',
+    'Comment=DeepSeek Harness desktop shell',
+    `Exec=${quotedExec(execPath)}`,
+    'Terminal=false',
+    'Categories=Development;',
+    'StartupWMClass=DeepSeek Harness',
+    `Hidden=${enabled ? 'false' : 'true'}`,
+    'X-GNOME-Autostart-enabled=false',
+    '',
+  ].join('\n')
+}
+
+/**
+ * Write the autostart entry; fail-closed on non-Linux platforms.
+ * @param enabled - Whether to enable open-at-login.
+ * @param env - Injectable environment and platform for tests.
+ * @returns Success flag.
+ */
+export function setLinuxOpenAtLogin(enabled: boolean, env: LinuxAutostartEnv = {}): boolean {
+  try {
+    const platform = env.platform ?? process.platform
+    if (platform !== 'linux') return false
+    const path = linuxAutostartFilePath(env)
+    mkdirSync(join(path, '..'), { recursive: true, mode: 0o700 })
+    writeFileSync(path, buildLinuxAutostartEntry(resolveLaunchPath(env), enabled), { mode: 0o600 })
+    return true
+  } catch {
+    return false
+  }
+}
+
+/**
+ * Read the autostart entry; missing files and parse failures read as disabled.
+ * @param env - Injectable environment and platform for tests.
+ * @returns Whether open-at-login is enabled.
+ */
+export function getLinuxOpenAtLogin(env: LinuxAutostartEnv = {}): boolean {
+  try {
+    const platform = env.platform ?? process.platform
+    if (platform !== 'linux') return false
+    const path = linuxAutostartFilePath(env)
+    if (!existsSync(path)) return false
+    const contents = readFileSync(path, 'utf8')
+    if (/^Hidden\s*=\s*true\s*$/gimu.test(contents)) return false
+    if (!/^Exec\s*=/gimu.test(contents)) return false
+    return true
+  } catch {
+    return false
+  }
+}
