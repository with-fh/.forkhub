diff --git a/packages/client/ui-settings-general/src/client/DesktopFeedRow.tsx b/packages/client/ui-settings-general/src/client/DesktopFeedRow.tsx
new file mode 100644
index 0000000000..d29996bd3e
--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/DesktopFeedRow.tsx
@@ -0,0 +1,51 @@
+/** Settings → Version → ForkHub publisher row: validate a catalog owner, persist it, repoint the live feed. */
+import type { PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { InjectFace } from '@deepseek-ai/dsh-client-ui-slots'
+import type { DesktopFeedSource } from './desktop-feed-source.ts'
+import css from './DesktopFeedRow.module.css'
+
+/** Framework-bound shell state and explicit Check action. */
+export interface DesktopFeedRowInjected {
+  hooks: { feed: DesktopFeedSource['store'] }
+  edit(input: string): void
+  check(): Promise<void>
+  dismiss(sequence: number): void
+}
+
+/**
+ * Render the ForkHub publisher input above the update check: typing an
+ * owner and pressing Check validates the catalog, persists the owner,
+ * repoints the live updater feed, and checks immediately. Nothing
+ * persists on failure; upstream has no `.forkhub` repo so it can never
+ * validate as a publisher.
+ */
+export function DesktopFeedRow({ useFeed, edit, check, dismiss, t }:
+  PropsRuntime<'settings.general.item'> & PropsLocale<'settings'> & InjectFace<DesktopFeedRowInjected>) {
+  const { state, failed, input, checking, notice } = useFeed(value => value)
+  const busy = checking
+  return <div className={css.row} role="group" aria-label={t('desktop.feed.title')}>
+    <div className={css.rowText}>
+      <div className={css.title}>{t('desktop.feed.title')}</div>
+      <div className={css.description}>{t('desktop.feed.description')}</div>
+      {(failed || state === undefined) && <div role="alert">{t('desktop.feed.unavailable')}</div>}
+      {notice !== undefined && <div role={notice.tone === 'error' ? 'alert' : 'status'}>
+        {notice.text}
+        <button type="button" onClick={() => { dismiss(notice.sequence) }} aria-label={t('desktop.feed.dismiss')}>
+          {t('desktop.feed.dismiss')}
+        </button>
+      </div>}
+    </div>
+    <div>
+      <input type="text" value={input} disabled={busy || state === undefined}
+        aria-label={t('desktop.feed.title')}
+        placeholder="with-fh"
+        onChange={(event) => { edit(event.currentTarget.value) }} />
+      <button type="button" disabled={busy || state === undefined || input.trim() === ''}
+        aria-busy={busy} aria-label={t('desktop.feed.check')}
+        onClick={() => { void check() }}>
+        {t('desktop.feed.check')}
+      </button>
+      {state !== undefined && <div>{t('desktop.feed.current', { owner: state.owner })}</div>}
+    </div>
+  </div>
+}
diff --git a/packages/client/ui-settings-general/src/client/desktop-feed-source.ts b/packages/client/ui-settings-general/src/client/desktop-feed-source.ts
new file mode 100644
index 0000000000..045fa1ab53
--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/desktop-feed-source.ts
@@ -0,0 +1,82 @@
+/** One shell-owned ForkHub publisher subscription for the Settings Version row. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { DesktopFeedBridge, DesktopFeedState } from '../types.ts'
+
+/** Shell state, typed owner input, and transient validation feedback. */
+export interface DesktopFeedSnapshot {
+  state?: DesktopFeedState
+  failed: boolean
+  input: string
+  checking: boolean
+  notice?: { sequence: number; tone: 'success' | 'error'; text: string }
+}
+
+/** Client observation; no catalog fetch happens here — the shell validates. */
+export class DesktopFeedSource {
+  /** Stable observation shared by the Version row. */
+  readonly store = createSnapshotStore<DesktopFeedSnapshot>({ failed: false, input: '', checking: false })
+  private live = true
+  private sequence = 0
+
+  /** @param bridge - Isolated shell API, present only in Desktop. */
+  constructor(private readonly bridge: DesktopFeedBridge) {
+    void bridge.get().then((state) => {
+      if (!this.live) return
+      this.store.set({ ...this.store.getSnapshot(), state, failed: false, input: state.owner })
+    }, () => {
+      if (!this.live) return
+      this.store.set({ ...this.store.getSnapshot(), failed: true })
+    })
+  }
+
+  /** Edit the owner input without validating yet. */
+  edit(input: string): void {
+    if (!this.live) return
+    this.store.set({ ...this.store.getSnapshot(), input })
+  }
+
+  /**
+   * Validate the typed owner: the shell checks the catalog, persists the
+   * owner on success, repoints the live updater feed, and checks
+   * immediately. Nothing persists on failure.
+   */
+  async check(): Promise<void> {
+    if (!this.live || this.store.getSnapshot().checking) return
+    const input = this.store.getSnapshot().input.trim()
+    if (input === '') return
+    this.store.set({ ...this.store.getSnapshot(), checking: true })
+    let message: string | undefined
+    let releases = 0
+    let applied = false
+    try {
+      const result = await this.bridge.set(input)
+      applied = result.kind === 'applied'
+      message = result.message
+      releases = result.kind === 'applied' ? result.releases : 0
+      if (this.live) {
+        this.store.set({ ...this.store.getSnapshot(), state: result.state, failed: false,
+          notice: { sequence: ++this.sequence, tone: applied ? 'success' as const : 'error' as const, text: message } })
+      }
+    } catch {
+      if (this.live) {
+        this.store.set({ ...this.store.getSnapshot(), failed: true,
+          notice: { sequence: ++this.sequence, tone: 'error' as const, text: 'Catalog check failed' } })
+      }
+    } finally {
+      if (this.live) this.store.set({ ...this.store.getSnapshot(), checking: false })
+    }
+    void releases
+    void applied
+  }
+
+  /** Retire only the toast whose animation completed. */
+  dismissNotice(sequence: number): void {
+    const current = this.store.getSnapshot()
+    if (current.notice?.sequence !== sequence) return
+    const { notice: _notice, ...next } = current
+    this.store.set(next)
+  }
+
+  /** Detach and ignore late IPC responses. */
+  dispose(): void { this.live = false }
+}
