diff --git a/electron/services/HardwareId.ts b/electron/services/HardwareId.ts
new file mode 100644
index 00000000..a233eb2c
--- /dev/null
+++ b/electron/services/HardwareId.ts
@@ -0,0 +1,194 @@
+/**
+ * electron/services/HardwareId.ts
+ *
+ * Stable per-device hardware identifier with graceful degradation.
+ *
+ * WHY THIS EXISTS: `trial:start` and `license:get-hardware-id` used to depend
+ * solely on the private `premium/` submodule's LicenseManager. Open-source /
+ * fork builds ship WITHOUT that submodule (see electron/premium/featureGate.ts),
+ * so every HWID lookup fell through to the literal string `'unavailable'` —
+ * which was then POSTed to `/v1/trial/start` as the device binding and
+ * rejected (`invalid_hwid`), making the free trial unclaimable and showing a
+ * raw placeholder in the trial UI ("hardware_id_unavailable").
+ *
+ * Resolution order (first non-placeholder wins — keeps existing activated
+ * installs on the SAME id they bound with):
+ *   1. Rust native module `getHardwareId()` (SHA-256 hex of machine UID).
+ *   2. Premium LicenseManager `getHardwareId()` (when submodule present).
+ *   3. OS machine id, SHA-256 hexed (Linux /etc/machine-id, macOS
+ *      IOPlatformUUID, Windows MachineGuid; then hostname + MACs).
+ *   4. Persisted random install id (per-userData, stable across restarts),
+ *      SHA-256 hexed — last resort so the value is at least stable.
+ *
+ * The function NEVER returns a placeholder ('', 'unavailable',
+ * 'hardware_id_unavailable', 'unknown-device', 'unknown'). It throws only
+ * when nothing stable can be produced at all, so callers can surface a real
+ * error instead of sending garbage to the server.
+ */
+
+import * as crypto from "crypto";
+import * as fs from "fs";
+import * as os from "os";
+import * as path from "path";
+
+const PLACEHOLDERS = new Set([
+  "",
+  "unavailable",
+  "hardware_id_unavailable",
+  "unknown",
+  "unknown-device",
+]);
+
+export function isPlaceholderHardwareId(value: unknown): boolean {
+  if (typeof value !== "string") return true;
+  const v = value.trim().toLowerCase();
+  return v === "" || PLACEHOLDERS.has(v);
+}
+
+function sha256hex(input: string): string {
+  return crypto.createHash("sha256").update(input, "utf8").digest("hex");
+}
+
+function tryNativeModuleHardwareId(): string | null {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { loadNativeModule } = require("../audio/nativeModuleLoader");
+    const mod = loadNativeModule?.();
+    const hwid: unknown = mod?.getHardwareId?.();
+    if (typeof hwid === "string" && !isPlaceholderHardwareId(hwid)) return hwid.trim();
+  } catch {
+    /* native binary not built/loaded — fall through */
+  }
+  return null;
+}
+
+function tryPremiumHardwareId(): string | null {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { LicenseManager } = require("../../premium/electron/services/LicenseManager");
+    const hwid: unknown = LicenseManager.getInstance().getHardwareId();
+    if (typeof hwid === "string" && !isPlaceholderHardwareId(hwid)) return hwid.trim();
+  } catch {
+    /* premium submodule absent (open-source / fork build) — fall through */
+  }
+  return null;
+}
+
+function readFileTrimmed(filePath: string): string | null {
+  try {
+    const content = fs.readFileSync(filePath, "utf8").trim();
+    return content || null;
+  } catch {
+    return null;
+  }
+}
+
+function tryExecTrimmed(command: string): string | null {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { execSync } = require("child_process");
+    const out = execSync(command, {
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "ignore"],
+      timeout: 5000,
+    } as unknown as object);
+    const text = String(out ?? "").trim();
+    return text || null;
+  } catch {
+    return null;
+  }
+}
+
+/** Best-effort raw OS machine id (NOT hashed — hashing happens in the caller). */
+function readOsMachineId(): string | null {
+  const platform = process.platform;
+
+  if (platform === "linux") {
+    const id =
+      readFileTrimmed("/etc/machine-id") || readFileTrimmed("/var/lib/dbus/machine-id");
+    if (id && !isPlaceholderHardwareId(id)) return id;
+  }
+
+  if (platform === "darwin") {
+    const uuid = tryExecTrimmed(
+      "ioreg -rd1 -c IOPlatformExpertDevice | grep -E '\"IOPlatformUUID\"' | sed -E 's/.*\"IOPlatformUUID\" = \"([^\"]+)\".*/\\1/'"
+    );
+    if (uuid && !isPlaceholderHardwareId(uuid)) return uuid;
+  }
+
+  if (platform === "win32") {
+    const guid = tryExecTrimmed(
+      "reg query HKLM\\SOFTWARE\\Microsoft\\Cryptography /v MachineGuid"
+    );
+    const match = guid?.match(/MachineGuid\s+REG_SZ\s+(\S+)/i);
+    if (match?.[1] && !isPlaceholderHardwareId(match[1])) return match[1].trim();
+  }
+
+  // Portable fallback: hostname + stable MAC list. Not as strong as a machine
+  // GUID, but deterministic for a given machine (VM MAC churn aside).
+  try {
+    const interfaces = os.networkInterfaces();
+    const macs: string[] = [];
+    for (const addrs of Object.values(interfaces)) {
+      for (const addr of addrs ?? []) {
+        const mac = (addr.mac ?? "").toLowerCase();
+        if (mac && mac !== "00:00:00:00:00:00" && !macs.includes(mac)) macs.push(mac);
+      }
+    }
+    const seed = `${os.hostname()}|${macs.sort().join(",")}`;
+    if (os.hostname() || macs.length > 0) return seed;
+  } catch {
+    /* ignore */
+  }
+
+  return null;
+}
+
+function userDataDir(): string | null {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { app } = require("electron") as typeof import("electron");
+    return app.getPath("userData");
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Stable install-scoped id, persisted under userData so repeated calls (and
+ * restarts) return the same value even on machines where no OS id is
+ * readable (containers, kiosks). Only used as a last resort.
+ */
+function getOrCreateInstallId(): string {
+  const dir = userDataDir();
+  const fallbackSeed = `${os.hostname()}|${os.userInfo?.()?.username ?? "user"}`;
+  if (!dir) return `install:${fallbackSeed}:${process.platform}`;
+
+  const filePath = path.join(dir, "install-id");
+  const existing = readFileTrimmed(filePath);
+  if (existing && !isPlaceholderHardwareId(existing)) return existing;
+
+  const fresh = crypto.randomUUID();
+  try {
+    fs.mkdirSync(dir, { recursive: true });
+    fs.writeFileSync(filePath, `${fresh}\n`, { mode: 0o600 });
+  } catch {
+    /* non-fatal: still return the fresh id for this session */
+    return `install:${fresh}`;
+  }
+  return fresh;
+}
+
+export function getStableHardwareId(): string {
+  const fromNative = tryNativeModuleHardwareId();
+  if (fromNative) return fromNative;
+
+  const fromPremium = tryPremiumHardwareId();
+  if (fromPremium) return fromPremium;
+
+  const osId = readOsMachineId();
+  if (osId && !isPlaceholderHardwareId(osId)) return sha256hex(osId);
+
+  // Last resort — stable per install, never a placeholder.
+  return sha256hex(`natively-install:${getOrCreateInstallId()}`);
+}
diff --git a/electron/services/__tests__/HardwareId.test.mjs b/electron/services/__tests__/HardwareId.test.mjs
new file mode 100644
index 00000000..893bb877
--- /dev/null
+++ b/electron/services/__tests__/HardwareId.test.mjs
@@ -0,0 +1,38 @@
+// electron/services/__tests__/HardwareId.test.mjs
+//
+// Regression test for the "hardware_id_unavailable" trial bug: open-source /
+// fork builds ship without the private `premium/` submodule, so HWID lookups
+// that depend solely on LicenseManager fell through to the literal string
+// 'unavailable' — which was POSTed to /v1/trial/start and rejected
+// (invalid_hwid), making the free trial unclaimable.
+//
+// getStableHardwareId() must NEVER return a placeholder: it walks
+// native module → premium LicenseManager → OS machine id → persisted
+// install id, and throws instead of returning garbage.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const { getStableHardwareId, isPlaceholderHardwareId } = await import(
+  pathToFileURL(path.resolve(__dirname, '../../../dist-electron/electron/services/HardwareId.js')).href
+);
+
+test('isPlaceholderHardwareId rejects every known placeholder shape', () => {
+  for (const bad of ['', '  ', 'unavailable', 'UNAVAILABLE', 'hardware_id_unavailable', 'unknown', 'unknown-device', null, undefined, 123]) {
+    assert.equal(isPlaceholderHardwareId(bad), true, `expected placeholder: ${String(bad)}`);
+  }
+  assert.equal(isPlaceholderHardwareId('a'.repeat(64)), false);
+});
+
+test('getStableHardwareId returns a stable 64-hex id, never a placeholder', () => {
+  const first = getStableHardwareId();
+  assert.equal(typeof first, 'string');
+  assert.match(first, /^[0-9a-f]{64}$/, 'must be SHA-256 hex');
+  assert.equal(isPlaceholderHardwareId(first), false);
+
+  const second = getStableHardwareId();
+  assert.equal(second, first, 'must be stable across calls in one process');
+});
