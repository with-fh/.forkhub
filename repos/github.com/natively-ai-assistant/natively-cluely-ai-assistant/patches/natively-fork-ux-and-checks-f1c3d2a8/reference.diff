+// electron/services/__tests__/ForkPatch2Sources.test.mjs
+//
+// Source assertions for the second ForkHub patch (calendar direct auth,
+// version-check fallback, dual fund links, maintainer card). Follows the
+// repo's TrialIpcRedaction convention: read source text, assert the
+// contract — no Electron runtime needed.
+
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+// electron/services/__tests__ -> repo root
+const ROOT = path.resolve(__dirname, '..', '..', '..');
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+test('calendar: direct PKCE branch coexists with the stock path', () => {
+  const src = read('electron/services/CalendarManager.ts');
+  // Fork channel resolution (baked id or explicit direct env).
+  assert.match(src, /readForkGoogleClientId/);
+  assert.match(src, /nativelyGoogleClientId/);
+  assert.match(src, /NATIVELY_CALENDAR_DIRECT/);
+  // PKCE wiring.
+  assert.match(src, /code_challenge/);
+  assert.match(src, /code_challenge_method/);
+  assert.match(src, /S256/);
+  assert.match(src, /exchangeCodeDirect/);
+  assert.match(src, /refreshTokenDirect/);
+  // Stock direct-with-upstream-client path preserved (upstream behavior
+  // when not direct): the committed client, its resolver, and the
+  // secret-gated token calls are intact. (Upstream v2.9.2 removed the
+  // natively-api proxy the reference patch was written against, so there
+  // are no /api/calendar/* call sites left to preserve — see report.)
+  assert.match(src, /DEFAULT_CALENDAR_CLIENT_ID/);
+  assert.match(src, /calendarOAuthClient/);
+  assert.match(src, /client_secret/);
+  // No silent misconfiguration: missing id refuses with a readable error.
+  assert.match(src, /missing Google client ID/);
+  // Catalog builds fall back to the maintainer's public Desktop client
+  // (gated so stock builds keep the stock client).
+  assert.match(src, /FORK_DEFAULT_CLIENT_ID/);
+  assert.match(src, /apps\.googleusercontent\.com/);
+  assert.match(src, /isForkCatalogBuild/);
+  assert.match(src, /UPSTREAM_OWNER/);
+});
+
+test('calendar: PKCE helpers stay pure (no electron import)', () => {
+  const src = read('electron/services/calendarPkce.ts');
+  assert.doesNotMatch(src, /from ['"]electron['"]/);
+  assert.match(src, /createPkcePair/);
+  assert.match(src, /oauth2\.googleapis\.com\/token/);
+  // Public client: no secret is ever SENT (docblock mentions are fine).
+  assert.doesNotMatch(src, /client_secret\s*:/i);
+});
+
+test('version check: updater failures fall back to the catalog compare', () => {
+  const src = read('electron/main.ts');
+  assert.match(src, /manualCheckFallbackPending/);
+  // Catch path runs the manual compare instead of broadcasting Error.
+  assert.match(src, /trying catalog compare/);
+  // Async 'error' events during a check are absorbed by the same fallback…
+  assert.match(src, /catalog fallback failed/);
+  // …while download-time errors still broadcast as before.
