--- /dev/null
+++ b/electron/services/calendarPkce.ts
@@ -0,0 +1,102 @@
+/**
+ * electron/services/calendarPkce.ts
+ *
+ * Pure PKCE helpers for Google OAuth (no electron imports — unit-testable
+ * in plain node).
+ *
+ * WHY: the stock flow exchanges the auth code through the natively-api
+ * proxy, which holds the secret for UPSTREAM's OAuth client. A fork build
+ * can never use that proxy with its own client id (Google binds the code
+ * to the initiating client). Desktop OAuth clients are public clients, so
+ * with PKCE (RFC 7636) the app exchanges and refreshes tokens DIRECTLY
+ * with Google — no secret, no proxy. See CalendarManager for the wiring.
+ */
+
+import * as crypto from "crypto";
+
+const GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token";
+
+export interface PkcePair {
+  /** High-entropy secret kept in memory for this flow only. */
+  verifier: string;
+  /** S256 challenge sent in the auth URL. */
+  challenge: string;
+}
+
+function base64UrlEncode(buf: Buffer): string {
+  return buf
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+/** Fresh verifier (86 chars) + its S256 challenge. */
+export function createPkcePair(): PkcePair {
+  const verifier = base64UrlEncode(crypto.randomBytes(64));
+  const challenge = base64UrlEncode(
+    crypto.createHash("sha256").update(verifier, "utf8").digest()
+  );
+  return { verifier, challenge };
+}
+
+async function postTokenRequest(
+  body: Record<string, string>,
+  signal?: AbortSignal
+): Promise<any> {
+  const response = await fetch(GOOGLE_TOKEN_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/x-www-form-urlencoded" },
+    body: new URLSearchParams(body).toString(),
+    signal,
+  });
+  if (!response.ok) {
+    const errBody = await response.json().catch(() => ({} as any));
+    const detail =
+      (errBody as any)?.error_description || (errBody as any)?.error || "";
+    const err = new Error(
+      `google_token_failed status=${response.status}${detail ? ` ${detail}` : ""}`.trim()
+    );
+    // Carry Google's machine-readable code so callers can apply the same
+    // dead-grant rule as the stock refresh path (no client_secret involved).
+    (err as any).code = (errBody as any)?.error || "token_request_failed";
+    throw err;
+  }
+  return response.json();
+}
+
+/** Direct code→token exchange (public client: no client_secret). */
+export function exchangeCodeDirect(
+  code: string,
+  verifier: string,
+  clientId: string,
+  redirectUri: string,
+  signal?: AbortSignal
+): Promise<any> {
+  return postTokenRequest(
+    {
+      code,
+      client_id: clientId,
+      redirect_uri: redirectUri,
+      grant_type: "authorization_code",
+      code_verifier: verifier,
+    },
+    signal
+  );
+}
+
+/** Direct refresh-token grant (public client: no client_secret). */
+export function refreshTokenDirect(
+  refreshToken: string,
+  clientId: string,
+  signal?: AbortSignal
+): Promise<any> {
+  return postTokenRequest(
+    {
+      refresh_token: refreshToken,
+      client_id: clientId,
+      grant_type: "refresh_token",
+    },
+    signal
+  );
+}
