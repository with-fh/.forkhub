+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const { getUpdateFeed, extractVersionFromTag, apiReleaseUrl, latestReleasePageUrl, isForkCounterUpgrade, parseBundleTag, isBundleCounterUpgrade } = await import(
+  pathToFileURL(path.resolve(__dirname, '../../dist-electron/electron/update/updateFeed.js')).href
+);
+
+test('update feed defaults to the ForkHub catalog (env-overridable)', () => {
+  const feed = getUpdateFeed();
+  assert.equal(feed.owner, process.env.NATIVELY_UPDATE_OWNER || 'with-fh');
+  assert.equal(feed.repo, process.env.NATIVELY_UPDATE_REPO || '.forkhub');
+  assert.match(
+    latestReleasePageUrl(feed),
+    /^https:\/\/github\.com\/.+\/.+\/releases\/latest$/
+  );
+});
+
+test('extractVersionFromTag handles plain, suffixed, and catalog-namespaced tags', () => {
+  assert.equal(extractVersionFromTag('v2.8.1'), '2.8.1');
+  assert.equal(extractVersionFromTag('2.8.1'), '2.8.1');
+  assert.equal(extractVersionFromTag('2.8.1-fh.imbios.1'), '2.8.1-fh.imbios.1');
+  assert.equal(
+    extractVersionFromTag('natively-ai-assistant-natively-cluely-ai-assistant--v2.8.1-fh1'),
+    '2.8.1-fh1'
+  );
+  assert.equal(
+    extractVersionFromTag('natively-ai-assistant-natively-cluely-ai-assistant--V2.8.8-fh1'),
+    '2.8.8-fh1'
+  );
+  assert.equal(extractVersionFromTag('V2.8.8'), '2.8.8');
+});
+
+test("apiReleaseUrl refuses 'latest' (ambiguous in a shared catalog)", () => {
+  assert.throws(() => apiReleaseUrl('latest'), /ambiguous in a shared catalog/);
+  assert.match(apiReleaseUrl('v2.8.1'), /releases\/tags\/v2\.8\.1$/);
+});
+
+test('isForkCounterUpgrade orders same-owner rebuilds only', () => {  assert.equal(isForkCounterUpgrade('2.8.1-fh.imbios.1', '2.8.1-fh.imbios.2'), true);
+  assert.equal(isForkCounterUpgrade('2.8.1-fh.with-fh.1', '2.8.1-fh.with-fh.2'), true);
+  assert.equal(isForkCounterUpgrade('2.8.1-fh.imbios.2', '2.8.1-fh.imbios.2'), false);
+  assert.equal(isForkCounterUpgrade('2.8.1-fh.imbios.2', '2.8.1-fh.imbios.1'), false);
+  // stock↔fork and cross-owner pairs never upgrade
+  assert.equal(isForkCounterUpgrade('2.8.1', '2.8.1-fh.imbios.1'), false);
+  assert.equal(isForkCounterUpgrade('2.8.1-fh.imbios.1', '2.8.1'), false);
+  assert.equal(isForkCounterUpgrade('2.8.1-fh.imbios.1', '2.8.1-fh.someone.9'), false);
+  assert.equal(isForkCounterUpgrade('2.8.1', '2.8.2'), false);
+});
+
+test('parseBundleTag parses bundle tags, rejects the rest', () => {
+  assert.deepEqual(parseBundleTag('natively-ai-assistant-natively-cluely-ai-assistant--v2.9.2-fh6'), { base: '2.9.2', n: 6 });
+  assert.deepEqual(parseBundleTag('natively-ai-assistant-natively-cluely-ai-assistant--V2.9.2-fh1'), { base: '2.9.2', n: 1 });
+  assert.equal(parseBundleTag('v2.9.2-fh.with-fh.3'), null);
+  assert.equal(parseBundleTag('v2.9.2'), null);
+  assert.equal(parseBundleTag('garbage'), null);
+});
+
+test('isBundleCounterUpgrade orders same-base bundles by counter only', () => {
+  const B = 'natively-ai-assistant-natively-cluely-ai-assistant--v2.9.2-fh6';
+  // installed bundle 2, latest bundle 6 → newer
+  assert.equal(isBundleCounterUpgrade(2, B, '2.9.2-fh.with-fh.2'), true);
+  // equal / older counters → not newer
+  assert.equal(isBundleCounterUpgrade(6, B, '2.9.2-fh.with-fh.2'), false);
+  assert.equal(isBundleCounterUpgrade(9, B, '2.9.2-fh.with-fh.2'), false);
+  // unknown installed counter (pre-stamp builds, dev) → fall through (false)
+  assert.equal(isBundleCounterUpgrade(null, B, '2.9.2-fh.with-fh.2'), false);
+  assert.equal(isBundleCounterUpgrade(undefined, B, '2.9.2-fh.with-fh.2'), false);
+  // different base → not this rule's business
+  assert.equal(isBundleCounterUpgrade(2, B, '2.9.3-fh.with-fh.1'), false);
+  // non-bundle tag → not this rule's business
+  assert.equal(isBundleCounterUpgrade(2, 'v2.9.2-fh.with-fh.3', '2.9.2-fh.with-fh.2'), false);
+});
diff --git a/electron/update/updateFeed.ts b/electron/update/updateFeed.ts
new file mode 100644
index 0000000..f2e9b71
--- /dev/null
+++ b/electron/update/updateFeed.ts
@@ -0,0 +1,396 @@
+/**
+ * electron/update/updateFeed.ts
+ *
+ * Single source of truth for where Natively checks for, downloads, and
+ * documents updates from.
+ *
+ * Fork builds (ForkHub) do NOT poll the upstream author's releases — they
+ * follow the ForkHub catalog (GitHub Releases of the `.forkhub` intent
+ * repository, currently `with-fh/.forkhub`), so a patched install is never
+ * offered (or silently handed) a stock build, and stock installs never see
+ * fork builds.
+ *
+ * Overrides (build-time or runtime env — runtime env only applies when the
+ * process is launched with it, e.g. dev; packaged GUI launches typically
+ * carry no env, so the baked defaults below are authoritative for ships):
+ *   NATIVELY_UPDATE_OWNER  (default "with-fh")
+ *   NATIVELY_UPDATE_REPO   (default ".forkhub")
+ *
+ * Catalog conventions (must hold for in-app updates to resolve):
+ *   - Installer releases in the catalog carry electron-updater manifests
+ *     (`latest.yml` / `latest-mac.yml` / `latest-linux.yml`, generated with
+ *     `generateUpdatesFilesForAllChannels`) — plain patched-source tarballs
+ *     are invisible to the updater.
+ *   - Catalog tags are namespaced per target:
+ *     `natively-ai-assistant-natively-cluely-ai-assistant--<version>`
+ *     so the shared per-owner catalog can host many targets.
+ *   - Built app versions carry a fork suffix (`<upstream>-fh.<owner>.<n>`,
+ *     e.g. `2.8.1-fh.imbios.1`) so fork builds compare newer than the
+ *     upstream they were derived from. The updater therefore runs with
+ *     `allowPrerelease = true` on this feed (see main.ts setupAutoUpdater).
+ */
+
+// NOTE: `process.env` is undefined in the Vite renderer — this module is
+// main-process only. Renderer UI that needs feed URLs must go through the
+// `get-update-feed` IPC (see ipcHandlers.ts + preload.ts).
+const envOwner =
+  typeof process !== "undefined" ? process.env?.NATIVELY_UPDATE_OWNER : undefined;
+const envRepo =
+  typeof process !== "undefined" ? process.env?.NATIVELY_UPDATE_REPO : undefined;
+
+export const UPDATE_FEED_OWNER = envOwner || "with-fh";
+export const UPDATE_FEED_REPO = envRepo || ".forkhub";
+
+/**
+ * ForkHub publisher override (the "which account's catalog do I update
+ * from" input in Settings → Version).
+ *
+ * Resolution order for the effective feed owner:
+ *   1. persisted override (`forkhub-updater.json` in userData — written by
+ *      the `set-update-feed-owner` IPC after catalog validation),
+ *   2. `NATIVELY_UPDATE_OWNER` env (dev / build-time),
+ *   3. baked default (`with-fh`).
+ *
+ * Stock installs never see fork builds and vice versa even when the user
+ * types another owner: validation (`checkPublisherCatalog`) only accepts
+ * accounts whose public `.forkhub` catalog has published releases, and the
+ * updater keeps `allowPrerelease` + the `fh` channel + the fork-counter
+ * gates, so a foreign feed that carries no `-fh.<owner>.<n>` builds for
+ * this install can never resolve into an "upgrade".
+ */
+
+/** GitHub account login shape (also covers orgs): 1–39 chars. */
+export function normalizeUpdateOwner(input: unknown): string | null {
+  if (typeof input !== "string") return null;
+  const v = input.trim().toLowerCase();
+  if (/^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$/.test(v)) return v;
+  return null;
+}
+
+function persistedOwnerPath(): string | null {
+  try {
+    // Lazy electron require keeps this module importable in plain node
+    // (see tests) — same pattern as readBakedBundleN below.
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { app } = require("electron") as typeof import("electron");
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const pathMod = require("path") as typeof import("path");
+    return pathMod.join(app.getPath("userData"), "forkhub-updater.json");
+  } catch {
+    return null;
+  }
+}
+
+/** Persisted publisher override, or null when unset/invalid/unreadable. */
+export function readPersistedUpdateOwner(): string | null {
+  try {
+    const p = persistedOwnerPath();
+    if (!p) return null;
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const fsMod = require("fs") as typeof import("fs");
+    const raw = JSON.parse(fsMod.readFileSync(p, "utf8"));
+    return normalizeUpdateOwner(raw?.owner);
+  } catch {
+    return null;
+  }
+}
+
+/** Persist a validated publisher override. Throws on invalid input. */
+export function writePersistedUpdateOwner(owner: string): void {
+  const norm = normalizeUpdateOwner(owner);
+  if (!norm) throw new Error(`Invalid GitHub owner: ${owner}`);
+  const p = persistedOwnerPath();
+  if (!p) throw new Error("userData unavailable — cannot persist update publisher");
+  // eslint-disable-next-line @typescript-eslint/no-var-requires
+  require("fs").writeFileSync(p, JSON.stringify({ owner: norm }, null, 2));
+}
+
+/** Tag namespace for Natively installer releases inside the shared catalog. */
+export const UPDATE_CATALOG_TAG_PREFIX =
+  "natively-ai-assistant-natively-cluely-ai-assistant--";
+
+/** Upstream feed — used only to decide whether legacy direct-asset URLs apply. */
+export const UPSTREAM_OWNER = "Natively-AI-assistant";
+export const UPSTREAM_REPO = "natively-cluely-ai-assistant";
+
+export interface UpdateFeed {
+  owner: string;
+  repo: string;
+}
+
+export function getUpdateFeed(): UpdateFeed {
+  const persisted = readPersistedUpdateOwner();
+  const owner = persisted ?? UPDATE_FEED_OWNER;
+  return { owner, repo: UPDATE_FEED_REPO };
+}
+
+/**
+ * Catalog validation for a publisher candidate (T3 parity: releases, not
+ * just the account). Accepts only when the public `{owner}/.forkhub`
+ * catalog carries at least one published, non-draft release. Private
+ * catalogs are unsupported — the check is unauthenticated, so only
+ * discoverable public releases count.
+ */
+export interface PublisherCatalogCheck {
+  ok: boolean;
+  owner: string;
+  repo: string;
+  /** Counted usable (published, non-draft) releases. */
+  releases: number;
+  message: string;
+}
+
+export function summarizePublisherReleases(releases: unknown): number {
+  if (!Array.isArray(releases)) return 0;
+  let n = 0;
+  for (const r of releases) {
+    if (r && typeof r === "object" && (r as any).draft !== true) n++;
+  }
+  return n;
+}
+
+export async function checkPublisherCatalog(
+  owner: string,
+  fetchImpl?: typeof fetch
+): Promise<PublisherCatalogCheck> {
+  const norm = normalizeUpdateOwner(owner);
+  const repo = UPDATE_FEED_REPO;
+  if (!norm) {
+    return {
+      ok: false,
+      owner: String(owner ?? "").trim(),
+      repo,
+      releases: 0,
+      message: "Enter a GitHub username or org (1–39 chars: letters, numbers, hyphens).",
+    };
+  }
+  const url = `https://api.github.com/repos/${norm}/${repo}/releases?per_page=100`;
+  let response: Response;
+  try {
+    const run =
+      fetchImpl ??
+      ((u: string) =>
+        fetch(u, {
+          headers: {
+            Accept: "application/vnd.github+json",
+            "User-Agent": "natively-forkhub-updater",
+          },
+        }));
+    response = await run(url);
+  } catch {
+    return {
+      ok: false,
+      owner: norm,
+      repo,
+      releases: 0,
+      message: "Could not reach github.com — check your connection and try again.",
+    };
+  }
+  if (response.status === 404) {
+    return {
+      ok: false,
+      owner: norm,
+      repo,
+      releases: 0,
+      message: `No public ${repo} repo for '${norm}' — publish a ForkHub catalog first.`,
+    };
+  }
+  if (response.status === 403) {
+    return {
+      ok: false,
+      owner: norm,
+      repo,
+      releases: 0,
+      message: "GitHub rate-limited the check — wait a minute and try again.",
+    };
+  }
+  if (!response.ok) {
+    return {
+      ok: false,
+      owner: norm,
+      repo,
+      releases: 0,
+      message: `GitHub lookup failed (HTTP ${response.status}) — try again.`,
+    };
+  }
+  const releases = await response.json().catch(() => null);
+  const usable = summarizePublisherReleases(releases);
+  if (usable === 0) {
+    return {
+      ok: false,
+      owner: norm,
+      repo,
+      releases: 0,
+      message: `'${norm}/${repo}' has no published releases yet — nothing to update from.`,
+    };
+  }
+  return {
+    ok: true,
+    owner: norm,
+    repo,
+    releases: usable,
+    message: `Getting updates from ${norm}/${repo} (${usable} release${usable === 1 ? '' : 's'} in the catalog).`,
+  };
+}
+
+/**
+ * Runtime twin of the feed block in main.ts setupAutoUpdater (which the
+ * F-707 source test pins — do not refactor that block; keep this in sync):
+ * follow the `fh` channel on the given feed with prereleases allowed and
+ * the library-side downgrade filter restored. `updater` is duck-typed so
+ * this module stays importable in plain node.
+ */
+export function applyForkFeed(
+  updater: {
+    setFeedURL: (opts: { provider: string; owner: string; repo: string }) => void;
+    channel: string;
+    allowDowngrade: boolean;
+    allowPrerelease: boolean;
+  },
+  feed: UpdateFeed
+): void {
+  updater.channel = "fh";
+  updater.allowDowngrade = false;
+  updater.setFeedURL({ provider: "github", owner: feed.owner, repo: feed.repo });
+  updater.allowPrerelease = true;
+}
+
+export function isUpstreamFeed(feed?: UpdateFeed): boolean {
+  const f = feed ?? getUpdateFeed();
+  return f.owner === UPSTREAM_OWNER && f.repo === UPSTREAM_REPO;
+}
+
+export function latestReleasePageUrl(feed?: UpdateFeed): string {
+  const f = feed ?? getUpdateFeed();
+  return `https://github.com/${f.owner}/${f.repo}/releases/latest`;
+}
+
+export function catalogReleaseTagUrl(tag: string, feed?: UpdateFeed): string {
+  const f = feed ?? getUpdateFeed();
+  return `https://github.com/${f.owner}/${f.repo}/releases/tag/${tag}`;
+}
+
+export function apiReleaseUrl(tagOrLatest: string, feed?: UpdateFeed): string {
+  const f = feed ?? getUpdateFeed();
+  if (tagOrLatest === "latest") {
+    // NOTE: intentionally NOT `/releases/latest` — in a shared per-owner
+    // catalog "latest" is whatever target released most recently. Callers
+    // that need the newest *Natively* release must list + filter by
+    // UPDATE_CATALOG_TAG_PREFIX (see ReleaseNotesManager).
+    throw new Error(
+      "apiReleaseUrl('latest') is ambiguous in a shared catalog — list releases and filter by UPDATE_CATALOG_TAG_PREFIX instead"
+    );
+  }
+  const tag = tagOrLatest.startsWith("v") ? tagOrLatest : `v${tagOrLatest}`;
+  return `https://api.github.com/repos/${f.owner}/${f.repo}/releases/tags/${tag}`;
+}
+
+export function apiReleasesListUrl(feed?: UpdateFeed): string {
+  const f = feed ?? getUpdateFeed();
+  return `https://api.github.com/repos/${f.owner}/${f.repo}/releases?per_page=30`;
+}
+
+/**
+ * Extracts the comparable version from a release tag.
+ *   "v2.8.1"            → "2.8.1"
+ *   "2.8.1-fh.imbios.1" → "2.8.1-fh.imbios.1"
+ *   "<slug>--v2.8.1-fh1" → "2.8.1-fh1"   (ForkHub catalog namespace)
+ */
+export function extractVersionFromTag(tag: string): string {
+  const namespaced = tag.includes("--") ? tag.split("--").pop() ?? tag : tag;
+  // Case-insensitive leading-v strip: catalog tags may carry upstream's
+  // capital-V style (`<slug>--V2.8.8-fh1`).
+  return namespaced.replace(/^v/i, "");
+}
+
+/**
+ * Fork-build ordering tiebreak for version gates that strip `-.*`
+ * pre-release suffixes before comparing (see main.ts isRealUpgrade /
+ * isVersionNewer).
+ *
+ * Returns true only when the remote carries a strictly newer
+ * `-fh.<owner>.<n>` rebuild counter for the SAME owner. Stock↔fork and
+ * cross-owner comparisons always return false, so a fork build can never
+ * auto-take (or be taken by) a foreign build.
+ */
+export function isForkCounterUpgrade(current: string, remote: string): boolean {
+  const parse = (v: string): { owner: string; n: number } | null => {
+    // Owner class includes `-` for hyphenated publishers (e.g. `with-fh`).
+    const m = /-fh\.([a-z0-9-]+)\.(\d+)$/i.exec(v.trim());
+    if (!m) return null;
+    const n = parseInt(m[2], 10);
+    return Number.isFinite(n) ? { owner: m[1].toLowerCase(), n } : null;
+  };
+  const c = parse(current);
+  const r = parse(remote);
+  return !!c && !!r && c.owner === r.owner && r.n > c.n;
+}
+
+export interface BundleTagInfo {
+  /** Upstream base version, e.g. "2.9.2". */
+  base: string;
+  /** Bundle counter N in `<slug>--v<base>-fh<N>`. */
+  n: number;
+}
+
+/**
+ * Parses a ForkHub bundle tag
+ * (`<slug>--v<base>-fh<N>`, e.g.
+ * `natively-ai-assistant-natively-cluely-ai-assistant--v2.9.2-fh6`).
+ * Returns null for anything else (updater releases, stock tags).
+ */
+export function parseBundleTag(tag: string): BundleTagInfo | null {
+  const m = /--v?(\d+\.\d+\.\d+)-fh(\d+)$/i.exec(tag.trim());
+  if (!m) return null;
+  const n = parseInt(m[2], 10);
+  return Number.isFinite(n) ? { base: m[1], n } : null;
+}
+
+/**
+ * Bundle counter baked at package time (see build.sh `forkhubBundleN`).
+ * Null when this build predates the stamp (or in dev) — callers then fall
+ * back to the version gates. Lazy electron require keeps this module
+ * importable in plain node (see tests).
+ */
+export function readBakedBundleN(): number | null {
+  try {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const { app } = require("electron") as typeof import("electron");
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const pathMod = require("path") as typeof import("path");
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const fsMod = require("fs") as typeof import("fs");
+    const pkg = JSON.parse(
+      fsMod.readFileSync(pathMod.join(app.getAppPath(), "package.json"), "utf8")
+    );
+    const raw = pkg?.build?.extraMetadata?.forkhubBundleN;
+    const n = typeof raw === "number" ? raw : parseInt(String(raw ?? ""), 10);
+    return Number.isFinite(n) ? n : null;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Bundle-counter ordering for the manual catalog compare (see main.ts
+ * checkForUpdatesManual): that compare resolves bundle tags, whose
+ * `-fh<N>` counters live in a different series than the installed updater
+ * version (`-fh.<owner>.<n>`), so the version gates cannot order them
+ * (same base compares equal, and the no-cross-talk guard refuses).
+ * When this build knows its own bundle counter and the latest tag is a
+ * same-base bundle, order by counter. Anything else returns false so
+ * callers fall through to the version gates (which own cross-base and
+ * updater-tag comparisons).
+ */
+export function isBundleCounterUpgrade(
+  installedN: number | null | undefined,
+  latestTag: string,
+  currentVersion: string
+): boolean {
+  if (installedN == null || !Number.isFinite(installedN)) return false;
+  const info = parseBundleTag(latestTag);
+  if (!info) return false;
+  const currentBase = currentVersion.replace(/^v/i, "").split("-")[0];
+  if (info.base !== currentBase) return false;
+  return info.n > installedN;
+}
diff --git a/electron/update/updatePublisher.test.mjs b/electron/update/updatePublisher.test.mjs
new file mode 100644
index 0000000..f2bb0e2
--- /dev/null
+++ b/electron/update/updatePublisher.test.mjs
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const {
+  normalizeUpdateOwner,
+  summarizePublisherReleases,
+  checkPublisherCatalog,
+  applyForkFeed,
+  getUpdateFeed,
+} = await import(
+  pathToFileURL(path.resolve(__dirname, '../../dist-electron/electron/update/updateFeed.js')).href
+);
+
+test('normalizeUpdateOwner accepts GitHub login shapes, lowercases', () => {
+  assert.equal(normalizeUpdateOwner('with-fh'), 'with-fh');
+  assert.equal(normalizeUpdateOwner('  With-FH  '), 'with-fh');
+  assert.equal(normalizeUpdateOwner('a'), 'a');
+  assert.equal(normalizeUpdateOwner('x'.repeat(39)), 'x'.repeat(39));
+});
+
+test('normalizeUpdateOwner rejects bad input', () => {
+  assert.equal(normalizeUpdateOwner(''), null);
+  assert.equal(normalizeUpdateOwner('   '), null);
+  assert.equal(normalizeUpdateOwner('has space'), null);
+  assert.equal(normalizeUpdateOwner('under_score'), null);
+  assert.equal(normalizeUpdateOwner('-lead'), null);
+  assert.equal(normalizeUpdateOwner('trail-'), null);
+  assert.equal(normalizeUpdateOwner('x'.repeat(40)), null);
+  assert.equal(normalizeUpdateOwner(null), null);
+  assert.equal(normalizeUpdateOwner(undefined), null);
+  assert.equal(normalizeUpdateOwner(42), null);
+});
+
+test('summarizePublisherReleases counts published non-drafts only', () => {
+  assert.equal(summarizePublisherReleases(null), 0);
+  assert.equal(summarizePublisherReleases({}), 0);
+  assert.equal(summarizePublisherReleases([]), 0);
+  assert.equal(
+    summarizePublisherReleases([
+      { tag_name: 'v1', draft: false },
+      { tag_name: 'v2' },
+      { tag_name: 'v3', draft: true },
+      { tag_name: 'v4', prerelease: true, draft: false },
+    ]),
+    3
+  );
+});
+
+function stubFetch(handler) {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url, init });
+    return handler(url);
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+const okReleases = (items) => ({
+  ok: true,
+  status: 200,
+  json: async () => items,
+});
+
+test('checkPublisherCatalog accepts an owner with published releases', async () => {
+  const fetchImpl = stubFetch(() =>
+    okReleases([{ tag_name: 'a', draft: false }, { tag_name: 'b', draft: true }])
+  );
+  const res = await checkPublisherCatalog('With-FH', fetchImpl);
+  assert.equal(res.ok, true);
+  assert.equal(res.owner, 'with-fh');
+  assert.equal(res.repo, '.forkhub');
+  assert.equal(res.releases, 1);
+  assert.match(fetchImpl.calls[0].url, /\/repos\/with-fh\/\.forkhub\/releases/);
+});
+
+test('checkPublisherCatalog rejects invalid owner without fetching', async () => {
+  const fetchImpl = stubFetch(() => okReleases([]));
+  const res = await checkPublisherCatalog('bad owner!', fetchImpl);
+  assert.equal(res.ok, false);
+  assert.equal(fetchImpl.calls.length, 0);
+});
+
+test('checkPublisherCatalog rejects empty catalogs', async () => {
+  const fetchImpl = stubFetch(() => okReleases([{ tag_name: 'd', draft: true }]));
+  const res = await checkPublisherCatalog('with-fh', fetchImpl);
+  assert.equal(res.ok, false);
+  assert.match(res.message, /no published releases/i);
+});
+
+test('checkPublisherCatalog maps 404 / 403 / 500 / network failure', async () => {
+  const notFound = await checkPublisherCatalog(
+    'ghost',
+    stubFetch(() => ({ ok: false, status: 404, json: async () => ({}) }))
+  );
+  assert.equal(notFound.ok, false);
+  assert.match(notFound.message, /No public/i);
+
+  const limited = await checkPublisherCatalog(
+    'with-fh',
+    stubFetch(() => ({ ok: false, status: 403, json: async () => ({}) }))
+  );
+  assert.equal(limited.ok, false);
+  assert.match(limited.message, /rate-limited/i);
+
+  const broken = await checkPublisherCatalog(
+    'with-fh',
+    stubFetch(() => ({ ok: false, status: 500, json: async () => ({}) }))
+  );
+  assert.equal(broken.ok, false);
+  assert.match(broken.message, /HTTP 500/);
+
+  const offline = await checkPublisherCatalog('with-fh', async () => {
+    throw new Error('boom');
+  });
+  assert.equal(offline.ok, false);
+  assert.match(offline.message, /connection/i);
+});
+
+test('applyForkFeed follows the fh channel with prereleases, no downgrade', () => {
+  const calls = [];
+  const updater = {
+    set channel(v) {
+      calls.push(['channel', v]);
+      // Mirror electron-updater's F-707 setter clobber.
+      this.allowDowngrade = true;
+    },
+    setFeedURL: (opts) => calls.push(['setFeedURL', opts]),
+  };
+  let flags = { allowDowngrade: undefined, allowPrerelease: undefined };
+  Object.defineProperties(updater, {
+    allowDowngrade: {
+      get: () => flags.allowDowngrade,
+      set: (v) => {
+        flags.allowDowngrade = v;
+        calls.push(['allowDowngrade', v]);
+      },
+    },
+    allowPrerelease: {
+      get: () => flags.allowPrerelease,
+      set: (v) => {
+        flags.allowPrerelease = v;
+        calls.push(['allowPrerelease', v]);
+      },
+    },
+  });
+  applyForkFeed(updater, { owner: 'with-fh', repo: '.forkhub' });
+  const kinds = calls.map((c) => c[0]);
+  assert.deepEqual(kinds, ['channel', 'allowDowngrade', 'allowDowngrade', 'setFeedURL', 'allowPrerelease']);
+  // The restore must come AFTER the setter clobber (F-707).
+  assert.equal(calls[kinds.lastIndexOf('allowDowngrade')][1], false);
+  assert.deepEqual(calls.find((c) => c[0] === 'setFeedURL')[1], {
+    provider: 'github',
+    owner: 'with-fh',
+    repo: '.forkhub',
+  });
+  assert.equal(flags.allowPrerelease, true);
+});
+
+test('getUpdateFeed defaults to with-fh/.forkhub in plain node (no persisted store)', () => {
+  const savedOwner = process.env.NATIVELY_UPDATE_OWNER;
+  const savedRepo = process.env.NATIVELY_UPDATE_REPO;
+  delete process.env.NATIVELY_UPDATE_OWNER;
+  delete process.env.NATIVELY_UPDATE_REPO;
+  try {
+    assert.deepEqual(getUpdateFeed(), { owner: 'with-fh', repo: '.forkhub' });
+  } finally {
+    if (savedOwner !== undefined) process.env.NATIVELY_UPDATE_OWNER = savedOwner;
+    if (savedRepo !== undefined) process.env.NATIVELY_UPDATE_REPO = savedRepo;
+  }
+});
