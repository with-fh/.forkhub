new file mode 100644
index 0000000..99df124
--- /dev/null
+++ b/electron/services/calendarPkce.ts
@@ -0,0 +1,118 @@
+/**
+ * electron/services/calendarPkce.ts
+ *
+ * Pure PKCE helpers for Google OAuth (no electron imports — unit-testable
+ * in plain node).
+ *
+ * WHY: the stock flow exchanges the auth code through the natively-api
+ * proxy, which holds the secret for UPSTREAM's OAuth client. A fork build
+ * can never use that proxy with its own client id (Google binds the code
+ * to the initiating client). The fork therefore exchanges and refreshes
+ * tokens DIRECTLY with Google — sending the fork OAuth client's own
+ * secret, which Google requires at the token endpoint even for Desktop
+ * clients with PKCE (without it Google answers 400 `invalid_request:
+ * client_secret is missing.`). Per Google's own native-app docs the
+ * secret is not treated as confidential here: it ships baked into the
+ * packaged app (see CalendarManager secret resolution + build.sh), never
+ * committed to source. See CalendarManager for the wiring.
+ */
+
+import * as crypto from "crypto";
+
+const GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token";
+
+export interface PkcePair {
+  /** High-entropy secret kept in memory for this flow only. */
+  verifier: string;
+  /** S256 challenge sent in the auth URL. */
+  challenge: string;
+}
+
+function base64UrlEncode(buf: Buffer): string {
+  return buf
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+}
+
+/** Fresh verifier (86 chars) + its S256 challenge. */
+export function createPkcePair(): PkcePair {
+  const verifier = base64UrlEncode(crypto.randomBytes(64));
+  const challenge = base64UrlEncode(
+    crypto.createHash("sha256").update(verifier, "utf8").digest()
+  );
+  return { verifier, challenge };
+}
+
+async function postTokenRequest(
+  body: Record<string, string>,
+  signal?: AbortSignal
+): Promise<any> {
+  const response = await fetch(GOOGLE_TOKEN_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/x-www-form-urlencoded" },
+    body: new URLSearchParams(body).toString(),
+    signal,
+  });
+  if (!response.ok) {
+    const errBody = await response.json().catch(() => ({} as any));
+    const detail =
+      (errBody as any)?.error_description || (errBody as any)?.error || "";
+    const err = new Error(
+      `google_token_failed status=${response.status}${detail ? ` ${detail}` : ""}`.trim()
+    );
+    // Carry Google's machine-readable code so callers can apply the same
+    // dead-grant rule as the stock refresh path.
+    (err as any).code = (errBody as any)?.error || "token_request_failed";
+    throw err;
+  }
+  return response.json();
+}
+
+/**
+ * Direct code→token exchange. `clientSecret` is sent when provided: Google
+ * requires it at the token endpoint even for Desktop clients using PKCE
+ * (absent → 400 `invalid_request: client_secret is missing.`). Omitted
+ * only when the caller has no secret to send.
+ */
+export function exchangeCodeDirect(
+  code: string,
+  verifier: string,
+  clientId: string,
+  redirectUri: string,
+  clientSecret?: string,
+  signal?: AbortSignal
+): Promise<any> {
+  return postTokenRequest(
+    {
+      code,
+      client_id: clientId,
+      redirect_uri: redirectUri,
+      grant_type: "authorization_code",
+      code_verifier: verifier,
+      ...(clientSecret ? { client_secret: clientSecret } : {}),
+    },
+    signal
+  );
+}
+
+/**
+ * Direct refresh-token grant. Same secret rule as the exchange above.
+ */
+export function refreshTokenDirect(
+  refreshToken: string,
+  clientId: string,
+  clientSecret?: string,
+  signal?: AbortSignal
+): Promise<any> {
+  return postTokenRequest(
+    {
+      refresh_token: refreshToken,
+      client_id: clientId,
+      grant_type: "refresh_token",
+      ...(clientSecret ? { client_secret: clientSecret } : {}),
+    },
+    signal
+  );
+}
